---
import Base from './Base.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  category: string;
  summary: string;
  year: string;
  role: string;
  stack: string[];
  status: string;
  links?: { label: string; href: string }[];
  ogImage?: string;
  description?: string;
  schemaType?: 'SoftwareApplication' | 'CreativeWork';
}

const {
  title,
  category,
  summary,
  year,
  role,
  stack,
  status,
  links = [],
  ogImage,
  description,
  schemaType = 'CreativeWork',
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  description: description ?? summary,
  url: new URL(Astro.url.pathname, SITE.url).href,
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  ...(schemaType === 'SoftwareApplication'
    ? { applicationCategory: 'BusinessApplication', operatingSystem: 'Web' }
    : {}),
};
---

<Base
  title={`${title} — ${SITE.name}`}
  description={description ?? summary}
  ogImage={ogImage}
  schema={schema}
>
  <article class="case">
    <header class="case__header">
      <div class="wrap">
        <a class="label case__back" href="/#work">← Selected work</a>
        <p class="label case__category">{category}</p>
        <h1 class="case__title">{title}</h1>
        <p class="lead case__summary">{summary}</p>

        <dl class="case__meta">
          <div>
            <dt class="label">Year</dt>
            <dd>{year}</dd>
          </div>
          <div>
            <dt class="label">Role</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt class="label">Status</dt>
            <dd>{status}</dd>
          </div>
        </dl>

        {
          links.length > 0 && (
            <div class="case__links">
              {links.map((l, i) => (
                <a
                  class:list={['btn', i > 0 && 'btn--ghost']}
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                >
                  {l.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="wrap case__body">
      <slot />

      <footer class="case__footer">
        <div>
          <p class="label">Stack</p>
          <ul class="tags case__stack">
            {stack.map((s) => <li class="tag">{s}</li>)}
          </ul>
        </div>
        <a class="case__next label" href="/#work">All selected work →</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .case__header {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .case__back {
    display: inline-block;
    margin-bottom: 2.5rem;
    transition: color 0.2s ease;
  }

  .case__back:hover {
    color: var(--accent);
  }

  .case__category {
    color: var(--accent);
  }

  .case__title {
    font-size: clamp(2.5rem, 1.9rem + 3vw, 4.5rem);
    margin-block: 1rem 1.5rem;
  }

  .case__summary {
    max-width: 62ch;
  }

  .case__meta {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.75rem, 5vw, 4rem);
    margin: 2.5rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .case__meta dd {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .case__body {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5.5rem);
  }

  .case__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .case__stack {
    margin-top: 0.75rem;
  }

  .case__next {
    transition: color 0.2s ease;
  }

  .case__next:hover {
    color: var(--accent);
  }

  /* ---- Long-form content styling, scoped to the case body ---- */
  .case__body :global(h2) {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem);
    margin-block: clamp(2.75rem, 5vw, 3.75rem) 1rem;
    max-width: 24ch;
  }

  .case__body :global(h3) {
    font-size: var(--step-h3);
    margin-block: 2rem 0.75rem;
  }

  .case__body :global(p) {
    max-width: 68ch;
    margin-bottom: 1.15rem;
    color: var(--ink-soft);
  }

  .case__body :global(ul),
  .case__body :global(ol) {
    max-width: 68ch;
    margin-block: 0 1.5rem;
    padding-left: 1.15rem;
    color: var(--ink-soft);
  }

  .case__body :global(li) {
    margin-bottom: 0.55rem;
    padding-left: 0.25rem;
  }

  .case__body :global(li::marker) {
    color: var(--accent);
  }

  .case__body :global(strong) {
    color: var(--ink);
    font-weight: 560;
  }

  .case__body :global(figure) {
    margin-block: clamp(2rem, 4vw, 3rem);
  }

  .case__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.1em 0.4em;
  }
</style>
