---
interface Step {
  label: string;
  note: string;
}

interface Props {
  caption?: string;
  steps: Step[];
}

const { steps, caption } = Astro.props;
---

<figure class="flow">
  <ol class="flow__track">
    {
      steps.map((step, i) => (
        <li class="flow__step">
          <span class="flow__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="flow__label">{step.label}</span>
          <span class="flow__note">{step.note}</span>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption class="flow__caption">{caption}</figcaption>}
</figure>

<style>
  .flow {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: clamp(1.25rem, 3vw, 2rem);
    /* Lets the steps respond to the column they sit in, not the viewport —
       the same component is used full-width and inside a half-width column. */
    container-type: inline-size;
  }

  .flow__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0;
  }

  .flow__step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1.15rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-right: 1.6rem;
  }

  /* Connector between steps */
  .flow__step::after {
    content: '';
    position: absolute;
    right: -1.15rem;
    top: 50%;
    width: 0.7rem;
    height: 1px;
    background: var(--line);
  }

  .flow__step::before {
    content: '';
    position: absolute;
    right: -1.25rem;
    top: 50%;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .flow__step:last-child {
    margin-right: 0;
  }

  .flow__step:last-child::after,
  .flow__step:last-child::before {
    display: none;
  }

  .flow__index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .flow__label {
    font-weight: 560;
    font-size: 0.9375rem;
    line-height: 1.25;
  }

  .flow__note {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .flow__caption {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  :global(.dark) .flow {
    background: var(--dark-surface);
    border-color: var(--dark-line);
  }

  :global(.dark) .flow__step {
    background: var(--dark-bg);
    border-color: var(--dark-line);
  }

  :global(.dark) .flow__step::after {
    background: var(--dark-line);
  }

  :global(.dark) .flow__index {
    color: var(--accent-soft);
  }

  :global(.dark) .flow__note,
  :global(.dark) .flow__caption {
    color: var(--dark-muted);
  }

  /* Below the width where a single row reads cleanly, stack vertically and
     rotate the connectors so none of them point into empty space. */
  @container (max-width: 760px) {
    .flow__track {
      grid-template-columns: 1fr;
    }

    .flow__step {
      margin-right: 0;
      margin-bottom: 1.4rem;
    }

    .flow__step::after {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1rem;
      width: 1px;
      height: 0.6rem;
    }

    .flow__step::before {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1.15rem;
      transform: translateX(-50%);
    }

    .flow__step:last-child {
      margin-bottom: 0;
    }
  }
</style>
