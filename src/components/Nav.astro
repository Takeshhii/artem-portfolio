---
import { LINKS, SITE } from '../config';
import { path, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  switchTo: { lang: Lang; href: string } | null;
}

const { lang, switchTo } = Astro.props;
const s = t[lang];

/**
 * Work and Projects live as anchors on the English homepage, which has no
 * Russian counterpart — so the Russian shell only links to what exists in
 * Russian. Same reason the brand points at the Russian index there.
 */
const items =
  lang === 'en'
    ? [
        { label: s.nav.work, href: '/#work' },
        { label: s.nav.projects, href: '/#projects' },
        { label: s.nav.writing, href: '/writing' },
        { label: s.nav.about, href: '/about' },
      ]
    : [
        { label: s.nav.writing, href: path('/writing', lang) },
        { label: s.nav.about, href: path('/about', lang) },
      ];

const brandHref = lang === 'en' ? '/' : path('/writing', lang);
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="nav__brand" href={brandHref}>
      {SITE.name}
    </a>

    <nav class="nav__links" aria-label="Primary">
      {items.map((item) => <a href={item.href}>{item.label}</a>)}
      <span class="nav__sep" aria-hidden="true"></span>
      <a href={LINKS.github} target="_blank" rel="noopener">GitHub</a>
      {LINKS.linkedin && (
        <a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      )}
      {switchTo && (
        <a class="nav__lang" href={switchTo.href} hreflang={switchTo.lang} rel="alternate">
          {s.langSwitch}
        </a>
      )}
    </nav>

    <button class="nav__toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav">
      <span class="sr-only">Menu</span>
      <span class="nav__bars" aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav__mobile" id="mobile-nav" data-nav-panel hidden>
    <div class="wrap nav__mobile-inner">
      {items.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={LINKS.github} target="_blank" rel="noopener">GitHub</a>
      {LINKS.linkedin && (
        <a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      )}
      <a href={`mailto:${LINKS.email}`}>Email</a>
      {switchTo && (
        <a href={switchTo.href} hreflang={switchTo.lang} rel="alternate">
          {s.langSwitch}
        </a>
      )}
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .nav[data-scrolled] {
    border-bottom-color: var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 68px;
  }

  .nav__brand {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nav__brand:hover {
    color: var(--accent);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-size: 0.9375rem;
  }

  .nav__links a {
    color: var(--ink-soft);
    transition: color 0.18s ease;
  }

  .nav__links a:hover {
    color: var(--accent);
  }

  .nav__lang {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .nav__lang:hover {
    border-color: var(--accent);
  }

  .nav__sep {
    width: 1px;
    height: 16px;
    background: var(--line);
  }

  .nav__toggle {
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    cursor: pointer;
  }

  .nav__bars,
  .nav__bars::before,
  .nav__bars::after {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .nav__bars::before,
  .nav__bars::after {
    content: '';
    position: absolute;
  }

  .nav__bars::before {
    transform: translateY(-5px);
  }

  .nav__bars::after {
    transform: translateY(5px);
  }

  .nav__toggle[aria-expanded='true'] .nav__bars {
    background: transparent;
  }

  .nav__toggle[aria-expanded='true'] .nav__bars::before {
    transform: rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__bars::after {
    transform: rotate(-45deg);
  }

  .nav__mobile {
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .nav__mobile-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 0.75rem 1.25rem;
  }

  .nav__mobile-inner a {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .nav__mobile-inner a:last-child {
    border-bottom: 0;
  }

  @media (max-width: 820px) {
    .nav__links {
      display: none;
    }

    .nav__toggle {
      display: inline-flex;
      position: relative;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });

  // Close the mobile panel after tapping a link.
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    })
  );

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 8) nav.setAttribute('data-scrolled', '');
    else nav.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
