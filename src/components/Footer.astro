---
import { LINKS, SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer dark" id="connect">
  <div class="wrap">
    <div class="footer__top">
      <div>
        <p class="label">Connect</p>
        <h2 class="footer__head">
          Open to AI, growth and product work.
        </h2>
        <p class="lead footer__lead">
          If you're building something at the intersection of growth, automation and
          product — or want to talk about a role — I'd like to hear about it.
        </p>
      </div>

      <ul class="footer__links">
        <li>
          <a href={`mailto:${LINKS.email}`}>
            <span class="label">Email</span>
            <span class="footer__value">{LINKS.email}</span>
          </a>
        </li>
        <li>
          <a href={LINKS.github} target="_blank" rel="noopener">
            <span class="label">GitHub</span>
            <span class="footer__value">github.com/Takeshhii</span>
          </a>
        </li>
        {
          LINKS.linkedin && (
            <li>
              <a href={LINKS.linkedin} target="_blank" rel="noopener">
                <span class="label">LinkedIn</span>
                <span class="footer__value">Profile</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div class="footer__bottom">
      <span>© {year} {SITE.name}</span>
      <span>{SITE.location}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 8vw, 6.5rem) 2rem;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--dark-line);
  }

  .footer__head {
    font-size: clamp(1.9rem, 1.4rem + 2vw, 3rem);
    margin-block: 0.75rem 1rem;
    max-width: 16ch;
  }

  .footer__lead {
    max-width: 46ch;
  }

  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    align-self: end;
  }

  .footer__links li {
    border-top: 1px solid var(--dark-line);
  }

  .footer__links li:last-child {
    border-bottom: 1px solid var(--dark-line);
  }

  .footer__links a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 0;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .footer__links a:hover {
    color: var(--accent-soft);
    padding-left: 0.5rem;
  }

  .footer__value {
    font-size: 1.0625rem;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dark-muted);
  }

  @media (max-width: 780px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
