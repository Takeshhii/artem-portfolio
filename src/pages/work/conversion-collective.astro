<Work
  title="Conversion Collective"
  category="Web · Conversion · Analytics"
  summary="A single-page site for a B2B revenue consultancy, built to convert visitors into booked calls rather than to present information — with every editable string living in one place."
  description="Conversion Collective — a dark editorial single-page site for a B2B sales-systems consultancy, structured around one booking flow, with content held in a single data object."
